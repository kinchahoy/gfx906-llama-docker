IMAGE_NAME=kinchahoy/gfx906-llama-docker:latest
LLAMA_PORT=8000
HF_CACHE=/home/raistlin/.cache/huggingface
# Host path for the legacy llama.cpp cache mount; Compose points the router's
# LLAMA_CACHE at the curated Hugging Face cache view inside the container.
LLAMA_CACHE=/home/raistlin/.cache/llama.cpp
LLAMA_PRESET=/home/raistlin/vr-repos/gfx906-llama-docker/live-monitored/llama-server-models.ini
VIDEO_GID=44
RENDER_GID=992
HIP_VISIBLE_DEVICES=0,1
GGML_CUDA_ALLREDUCE=internal
GGML_ENABLE_CUSTOM_AR=1
HSA_FORCE_FINE_GRAIN_PCIE=1
GGML_CUDA_TP_OVERLAP=1
GGML_CUDA_TP_OVERLAP_BF16=1

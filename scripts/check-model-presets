#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
preset_file=${1:-"${repo_root}/live-monitored/llama-server-models.ini"}

python3 - "${preset_file}" <<'PY'
import configparser
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
config = configparser.ConfigParser(interpolation=None)
config.optionxform = str.lower

try:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "version = 1":
        raise ValueError("first line must be 'version = 1'")
    config.read_string("\n".join(lines[1:]))
except (OSError, configparser.Error) as error:
    raise SystemExit(f"invalid preset file {path}: {error}")
except ValueError as error:
    raise SystemExit(f"invalid preset file {path}: {error}")

expected_sections = [
    "REC-qwen3.8-27b-q8_0-mtp2",
    "REC-gemma-4-31b-it-ud-q5_k_xl-mtp2",
    "REC-gpt-oss-120b-mxfp4-2x50k",
    "gpt-oss-20b-mxfp4-3x150k-tuned",
]
model_sections = [section for section in config.sections() if section != "*"]
if model_sections != expected_sections:
    raise SystemExit(
        "model catalog must contain exactly these sections in order:\n  "
        + "\n  ".join(expected_sections)
        + "\nfound:\n  "
        + "\n  ".join(model_sections)
    )

for section in config.sections():
    for option in config[section]:
        if "cache-type" in option:
            raise SystemExit(
                f"{section}: {option} overrides KV precision; native KV is required"
            )

required = {
    "REC-qwen3.8-27b-q8_0-mtp2": {
        "ctx-size": "261888",
        "parallel": "3",
        "spec-type": "draft-mtp",
        "spec-draft-n-max": "2",
    },
    "REC-gemma-4-31b-it-ud-q5_k_xl-mtp2": {
        "model": "/home/llama/.cache/huggingface/hub/models--unsloth--gemma-4-31B-it-GGUF/snapshots/6a969627f3372486b68c2bf2ed87fdfd972cc8d0/gemma-4-31B-it-UD-Q5_K_XL.gguf",
        "model-draft": "/home/llama/.cache/huggingface/hub/models--unsloth--gemma-4-31B-it-GGUF/snapshots/8906b3db2e669a0b1d6293c315d3f9fbf934a86d/MTP/gemma-4-31B-it-Q8_0-MTP.gguf",
        "ctx-size": "256000",
        "parallel": "3",
        "spec-type": "draft-mtp",
        "spec-draft-n-max": "2",
    },
    "REC-gpt-oss-120b-mxfp4-2x50k": {
        "hf-repo": "ggml-org/gpt-oss-120b-GGUF",
        "gpu-layers": "99",
        "flash-attn": "on",
        "ctx-size": "100000",
        "main-gpu": "0",
        "fit-target": "500",
        "no-mmap": "true",
        "tensor-split": "16,17",
        "parallel": "2",
    },
    "gpt-oss-20b-mxfp4-3x150k-tuned": {
        "hf-repo": "ggml-org/gpt-oss-20b-GGUF",
        "ctx-size": "150000",
        "fit": "on",
        "fit-target": "500",
        "parallel": "3",
        "flash-attn": "on",
        "main-gpu": "0",
        "no-mmap": "true",
    },
}

for section, options in required.items():
    for option, expected in options.items():
        actual = config[section].get(option)
        if actual != expected:
            raise SystemExit(
                f"{section}: expected {option}={expected!r}, found {actual!r}"
            )

print(f"validated {len(model_sections)} model presets; KV cache precision is native")
PY

#!/usr/bin/env bash
set -euo pipefail

# Build a small Hugging Face cache index containing only the model weight sets
# intentionally exposed by the MI60 router. Model blobs are hard-linked from
# the normal cache, so this uses metadata space rather than another ~140 GB.

hf_root=${HF_CACHE:-/home/raistlin/.cache/huggingface}
source_cache=${HF_HUB_CACHE:-"${hf_root}/hub"}
router_cache=${MI60_ROUTER_CACHE:-"${hf_root}/mi60-router"}
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest=${MODEL_CACHE_MANIFEST:-"${repo_root}/models/cache-manifest.tsv"}

[[ -d "${source_cache}" ]] || {
    printf 'Hugging Face cache is not readable: %s\n' "${source_cache}" >&2
    exit 1
}
[[ -r "${manifest}" ]] || {
    printf 'Model cache manifest is not readable: %s\n' "${manifest}" >&2
    exit 1
}

case "${router_cache}" in
    "${hf_root}"/*) ;;
    *)
        printf 'MI60_ROUTER_CACHE must be below HF_CACHE (%s): %s\n' \
            "${hf_root}" "${router_cache}" >&2
        exit 1
        ;;
esac

stage=$(mktemp -d "${hf_root}/.mi60-router.XXXXXX")

repo_path() {
    printf '%s/models--%s\n' "${source_cache}" "${1//\//--}"
}

new_repo_path() {
    printf '%s/models--%s\n' "${stage}" "${1//\//--}"
}

choose_cached_file() {
    local repo=$1
    local pattern=$2
    local minimum_bytes=$3
    local revision=${4:-}
    local candidate size
    local source_repo
    source_repo=$(repo_path "${repo}")
    local snapshot_root=${source_repo}/snapshots
    [[ -n "${revision}" ]] && snapshot_root=${snapshot_root}/${revision}

    while IFS= read -r candidate; do
        [[ -n "${candidate}" ]] || continue
        size=$(stat -Lc '%s' "${candidate}" 2>/dev/null || printf '0')
        if (( size >= minimum_bytes )); then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done < <(
        find "${snapshot_root}" -type l -iname "${pattern}" \
            -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-
    )

    printf 'No complete cached file for %s matching %s (minimum %s bytes)\n' \
        "${repo}" "${pattern}" "${minimum_bytes}" >&2
    return 1
}

add_cached_file() {
    local repo=$1
    local revision=$2
    local source_file=$3
    local exposed_name=$4
    local source_blob blob_name destination_repo destination_snapshot

    source_blob=$(readlink -f -- "${source_file}")
    [[ -f "${source_blob}" ]] || {
        printf 'Cached blob is missing: %s\n' "${source_file}" >&2
        return 1
    }

    blob_name=$(basename -- "${source_blob}")
    destination_repo=$(new_repo_path "${repo}")
    destination_snapshot=${destination_repo}/snapshots/${revision}
    mkdir -p "${destination_repo}/blobs" "${destination_snapshot}"

    if [[ ! -e "${destination_repo}/blobs/${blob_name}" ]]; then
        ln -- "${source_blob}" "${destination_repo}/blobs/${blob_name}"
    fi
    ln -sfn -- "../../blobs/${blob_name}" "${destination_snapshot}/${exposed_name}"
}

set_main_ref() {
    local repo=$1
    local revision=$2
    local destination_repo
    destination_repo=$(new_repo_path "${repo}")
    mkdir -p "${destination_repo}/refs"
    printf '%s\n' "${revision}" > "${destination_repo}/refs/main"
}

declare -A repo_revision group_total group_min
while IFS=$'\t' read -r repo group_spec pattern minimum_bytes exposed_name; do
    [[ -n "${repo}" && "${repo:0:1}" != '#' ]] || continue
    [[ -n "${group_spec}" && -n "${pattern}" && -n "${minimum_bytes}" && \
        -n "${exposed_name}" ]] || {
        printf 'Malformed model cache manifest row for %s\n' "${repo}" >&2
        exit 1
    }

    group=${group_spec%@*}
    group_limit=${group_spec##*@}
    [[ "${group}" != "${group_spec}" && "${group_limit}" =~ ^[0-9]+$ ]] || {
        printf 'Invalid manifest group specification: %s\n' "${group_spec}" >&2
        exit 1
    }
    group_min["${group}"]=${group_limit}
    [[ -v "group_total[${group}]" ]] || group_total["${group}"]=0

    revision=${repo_revision["${repo}"]:-}
    source_file=$(choose_cached_file "${repo}" "${pattern}" "${minimum_bytes}" "${revision}")
    if [[ -z "${revision}" ]]; then
        revision=$(basename -- "$(dirname -- "${source_file}")")
        repo_revision["${repo}"]=${revision}
    fi
    file_size=$(stat -Lc '%s' "${source_file}")
    (( group_total["${group}"] += file_size ))
    add_cached_file "${repo}" "${revision}" "${source_file}" "${exposed_name}"
done < "${manifest}"

for group in "${!group_min[@]}"; do
    (( group_total["${group}"] >= group_min["${group}"] )) || {
        printf 'Model group %s is incomplete (%s bytes, need %s)\n' \
            "${group}" "${group_total[${group}]}" "${group_min[${group}]}" >&2
        exit 1
    }
done
for repo in "${!repo_revision[@]}"; do
    set_main_ref "${repo}" "${repo_revision[${repo}]}"
done

if [[ -e "${router_cache}" ]]; then
    backup=${router_cache}.backup-$(date +%Y%m%d-%H%M%S)
    [[ ! -e "${backup}" ]] || backup=${backup}-${BASHPID}
    mv -- "${router_cache}" "${backup}"
    printf 'Previous curated cache metadata moved to %s\n' "${backup}"
fi
mv -- "${stage}" "${router_cache}"

printf 'Prepared offline MI60 router cache at %s\n' "${router_cache}"
printf 'Manifest: %s\n' "${manifest}"

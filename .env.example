LLAMA_BUILD_DIR=/home/raistlin/infer/mx-llama.cpp/build
HF_CACHE=/home/raistlin/.cache/huggingface
LLAMA_CACHE=/home/raistlin/.cache/llama.cpp
LLAMA_PORT=8000
VIDEO_GID=44
RENDER_GID=992
IMAGE_NAME=kinchahoy/gfx906-llama-docker:latest

# Validated two-MI60 Qwen3.8 Q8_0 tensor-parallel runtime.
HIP_VISIBLE_DEVICES=0,1
GGML_CUDA_ALLREDUCE=internal
GGML_ENABLE_CUSTOM_AR=1
HSA_FORCE_FINE_GRAIN_PCIE=1
GGML_CUDA_TP_OVERLAP=1
# Faster BF16 transport is a small precision tradeoff versus F32 reduction.
GGML_CUDA_TP_OVERLAP_BF16=1

# Empty means latest TheRock nightly. Set a complete version to roll back.
THEROCK_VERSION=
